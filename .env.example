OPENAI_API_KEY=
VISION_MODEL_NAME=gpt-4o

# model for the floor plan layout step (reasoning model recommended)
LAYOUT_MODEL_NAME=gpt-5.5

# model caches (default: <repo>/.cache)
# HF_HOME=D:/Personal/cozmo/.cache/huggingface
# TORCH_HOME=D:/Personal/cozmo/.cache/torch
# camera poses model (apache = commercial use OK; facebook/map-anything is non-commercial)
MAPANYTHING_MODEL_NAME=facebook/map-anything-apache

# video tier
# speech to text (whisper-1 gives timestamps; gpt-4o-transcribe does not)
TRANSCRIBE_MODEL_NAME=whisper-1
# model that finds damage in the transcript (default chain: gpt-4.1,gpt-4o)
# DAMAGE_MODEL_NAME=gpt-4.1
# vision model that picks the damage box in a frame (default chain: gpt-4.1,gpt-4o)
# DAMAGE_VISION_MODEL_NAME=gpt-4.1
# ffmpeg binary if not on PATH (falls back to imageio-ffmpeg)
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
